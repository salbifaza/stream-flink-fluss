# Copy to .env to override the defaults. docker-compose.yml falls back to
# these same values when .env is absent.

# Source Postgres.
SOURCE_PG_USER=ecommerce
SOURCE_PG_PASSWORD=ecommerce
SOURCE_PG_DB=ecommerce

# ClickHouse bootstrap/admin user: creates tables and the sink user, runs
# operator queries. The Flink sink never connects as it.
CLICKHOUSE_USER=ch_admin
CLICKHOUSE_PASSWORD=ch_admin_password

# The INSERT-only user Flink's JDBC sink connects as. Rendered into
# flink/sql/clickhouse_sink_job.sql at submit time.
CLICKHOUSE_SINK_USER=flink_sink
CLICKHOUSE_SINK_PASSWORD=flink_sink_password
